{
  "name": "deckhand",
  "private": true,
  "version": "0.1.0-alpha.2",
  "type": "module",
  "scripts": {
    "dev": "bun run build:sidecar && tauri dev",
    "dev:ui": "vite",
    "dev:sidecar": "cd sidecar && go run ./cmd/deckhand-sidecar -- --addr 127.0.0.1:7420",
    "build": "tsc --noEmit && vite build",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "build:cli": "cd sidecar && go build -o ../bin/deckhand ./cmd/deckhand",
    "icons": "bash scripts/generate-icons.sh",
    "version": "bun scripts/set-version.mjs",
    "version:check": "bun scripts/check-version.mjs",
    "tauri": "tauri",
    "tauri:dev": "bun run build:sidecar && tauri dev",
    "tauri:build": "bun run build:sidecar && tauri build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.66.9",
    "@tanstack/react-router": "^1.105.0",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.25.0",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.3.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "lightningcss": "^1.32.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
